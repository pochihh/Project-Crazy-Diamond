<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>loopback_udp</transport_id>
            <type>UDPv4</type>
            <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
            <maxInitialPeersRange>32</maxInitialPeersRange>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="loopback" is_default_profile="true">
        <rtps>
            <builtin>
                <initialPeersList>
                    <locator><udpv4><address>127.0.0.1</address></udpv4></locator>
                </initialPeersList>
                <metatrafficUnicastLocatorList><locator/></metatrafficUnicastLocatorList>
            </builtin>
            <useBuiltinTransports>false</useBuiltinTransports>
            <userTransports><transport_id>loopback_udp</transport_id></userTransports>
        </rtps>
    </participant>
</profiles>
